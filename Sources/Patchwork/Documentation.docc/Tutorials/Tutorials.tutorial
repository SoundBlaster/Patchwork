@Tutorials(name: "Patchwork Migration Tutorials") {
    @Intro(title: "Migrate a UIKit list all the way to SwiftUI") {
        Replace legacy rows incrementally inside one list, then remove the migration bridge and finish with a native SwiftUI screen.
    }

    @Chapter(name: "Migrate a UIKit List to SwiftUI") {
        Use Patchwork to move from legacy UIKit cells through a mixed migration stage, then replace the entire collection screen with native SwiftUI.
        @Image(source: "patchwork-content-map", alt: "A migration path moves from a legacy UIKit list through mixed Patchwork renderers and SwiftUI rows to a native SwiftUI List.")
        @TutorialReference(tutorial: "doc:UIKitMigrationWithPatchwork")
    }

}
