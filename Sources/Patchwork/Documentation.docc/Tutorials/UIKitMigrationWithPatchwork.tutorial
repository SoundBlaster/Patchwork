@Tutorial(time: 35) {
    @Intro(title: "Migrate a UIKit List to SwiftUI with Patchwork") {
        Replace a large UIKit list one row type at a time: keep legacy cells that have not been migrated, move selected rows through Patchwork renderers, then finish with a native SwiftUI `List`.

        This guide targets iOS 18 and later. ScreenKit owns the collection and snapshots, while Patchwork adapts rendering during the mixed migration stage. Once every row is SwiftUI, remove both bridge packages from this screen.
    }

    @Section(title: "Keep the legacy cell") {
        @ContentAndMedia {
            Start with the custom cell your UIKit screen already uses. `Patchwork.legacyCell` creates the collection registration and calls your configure closure for the current item while preserving the cell's reuse behavior.
        }

        @Steps {
            @Step {
                Adapt the existing cell and use its renderer in a ScreenKit list.

                @Code(name: "CatalogScreen.swift", file: "01-preserve-legacy-cell.swift")
            }
        }
    }

    @Section(title: "Add a UIKit content configuration") {
        @ContentAndMedia {
            Use a `UIContentConfiguration` for rows that no longer need a custom cell subclass. Keep both renderers outside the per-item closure; select between their stable values using an item discriminator.
        }

        @Steps {
            @Step {
                Add a configuration renderer and route each row to the legacy or configuration adapter.

                @Code(name: "CatalogScreen.swift", file: "02-add-content-configuration.swift", previousFile: "01-preserve-legacy-cell.swift")
            }
        }
    }

    @Section(title: "Host an existing UIView") {
        @ContentAndMedia {
            If a design-system component is already a `UIView`, keep it and supply a factory plus an item update closure. Patchwork places it in UIKit's content-configuration lifecycle.
        }

        @Steps {
            @Step {
                Add the UIView adapter for the rows that already use the component.

                @Code(name: "CatalogScreen.swift", file: "03-host-existing-uiview.swift", previousFile: "02-add-content-configuration.swift")
            }
        }
    }

    @Section(title: "Introduce a SwiftUI row") {
        @ContentAndMedia {
            Move only the row that benefits from SwiftUI. The adapter uses the item's stable identity when hosting the view; keep durable editing or business state in your model or feature state.
        }

        @Steps {
            @Step {
                Add a SwiftUI renderer and display all four content styles in the same collection.

                @Code(name: "CatalogScreen.swift", file: "04-add-swiftui-row.swift", previousFile: "03-host-existing-uiview.swift")
            }
        }
    }

    @Section(title: "Update the screen without adding another data source") {
        @ContentAndMedia {
            The feature continues to own catalog values. Send the latest items to the ScreenKit controller; Patchwork does not apply snapshots or own navigation.
        }

        @Steps {
            @Step {
                Apply updated rows with stable IDs through `ScreenViewController.setItems`.

                @Code(name: "CatalogScreen.swift", file: "05-update-catalog.swift", previousFile: "04-add-swiftui-row.swift")
            }
        }
    }

    @Section(title: "Move the remaining rows to SwiftUI") {
        @ContentAndMedia {
            Replace the remaining cell, configuration, and `UIView` renderers with one retained SwiftUI renderer. The collection still runs through ScreenKit at this stage, but every row is now a SwiftUI view. See the [Patchwork adapter API](https://soundblaster.github.io/Patchwork/documentation/patchwork/#choose-an-adapter) for the renderer signature.
        }

        @Steps {
            @Step {
                Remove the item-style switch and render every catalog item through `Patchwork.swiftUI`.

                @Code(name: "CatalogScreen.swift", file: "06-all-swiftui-rows.swift", previousFile: "05-update-catalog.swift")
            }
        }
    }

    @Section(title: "Finish with a native SwiftUI screen") {
        @ContentAndMedia {
            With no UIKit renderer left, Patchwork and ScreenKit have completed their migration role. Replace the collection-backed controller with SwiftUI `NavigationStack` and `List`; the resulting screen imports SwiftUI only.
        }

        @Steps {
            @Step {
                Remove the bridge imports and controller builder, then display the catalog with SwiftUI `List`.

                @Code(name: "CatalogScreen.swift", file: "07-native-swiftui-list.swift", previousFile: "06-all-swiftui-rows.swift")
            }
        }
    }
}
